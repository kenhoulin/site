@article{cobb2017growing,
  author      = {Cobb, J. Adam and Lin, Ken-Hou},
  title       = {Growing Apart: The Declining Firm-Size Wage Effect and Its Wage Inequality Consequence},
  year        = {2017},
  journal     = {Organization Science},
  volume      = {28},
  number      = {3},
  pages       = {429-446},
  doi         = {10.1287/orsc.2017.1125},
  keywords    = {labor-markets, organizations, inequality},
  abstract    = {This study argues that large firms have been a prominent labor-market institution that mitigates inequality by compensating low- and middle-wage employees with a greater premium than their higher-wage counterparts. Using data from the Current Population Survey and the Survey of Income and Program Participation, the authors find that between 1989 and 2014 the average firm-size wage premium declined markedly — but exclusively at the lower and middle of the wage distribution, with no change at the top. The uneven decline could account for roughly 20 percent of rising wage inequality during this period.},
}

@article{lin2017gender,
  author      = {Lin, Ken-Hou and Neely, Megan Tobias},
  title       = {Gender, Parental Status, and the Wage Premium in Finance},
  year        = {2017},
  journal     = {Social Currents},
  volume      = {4},
  number      = {6},
  pages       = {535-555},
  doi         = {10.1177/2329496516686622},
  keywords    = {gender, financialization, labor-markets, inequality},
  abstract    = {Previous research documents a growing wage premium for elite financial workers since the 1980s, and substantial gender disparities in earnings and career mobility among them. This article examines how the wage premium for working in the financial sector varies by gender and parental status across the wage distribution. The authors report that women earn a greater wage premium than men in low-wage financial jobs, while almost all of the increase in wages in high finance is captured by elite men, particularly fathers. The financial sector thus simultaneously exacerbates and mitigates gender inequalities at different locations of the labor market.},
}

@article{lin2016rise,
  author      = {Lin, Ken-Hou},
  title       = {The Rise of Finance and Firm Employment Dynamics},
  year        = {2016},
  journal     = {Organization Science},
  volume      = {27},
  number      = {4},
  pages       = {972-988},
  doi         = {10.1287/orsc.2016.1073},
  keywords    = {financialization, organizations, labor-markets},
  abstract    = {This article investigates the organizational links between the rise of finance and employment. The rise of finance increased the transfer of resources from productive activities to financial markets and marginalized the role of labor in revenue-generating and distributing processes, which in turn led to weaker employment growth. This broader process operates through three organizational processes: firms' increasing operation in banking, trading, and other financial activities depresses investment in the workforce; the expansion of corporate debt imposes constraints on employment growth; and the growing rewards for shareholders further diverts resources away from workers.},
}

